rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Website Templates Catalog
    match /website_templates/{templateId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // Template Purchase Orders
    match /template_orders/{orderId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if true;
    }

    // Portfolio Solutions
    match /portfolio_solutions/{solutionId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // Ready Solutions & Requests
    match /ready_solutions/{readyId} {
      allow read: if true;
      allow create, update, delete: if true;
    }
    match /ready_solution_requests/{reqId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if true;
    }

    // Custom Solution Orders
    match /custom_solution_orders/{orderId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if true;
    }

    // Enquiries
    match /enquiries/{enquiryId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if true;
    }

    // Work Applications
    match /work_applications/{appId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if true;
    }

    // Business AI Items
    match /business_ai_items/{itemId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // Founder Profile & Settings
    match /founder_profile/{profileId} {
      allow read: if true;
      allow create, update, delete: if true;
    }
    match /brand_logo_config/{configId} {
      allow read: if true;
      allow create, update, delete: if true;
    }
    match /settings/{settingId} {
      allow read: if true;
      allow create, update, delete: if true;
    }
  }
}
